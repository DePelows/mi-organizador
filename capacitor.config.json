{
  "appId": "com.focus.app",
  "appName": "Focus",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0f0f14"
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0f0f14",
      "overlaysWebView": false,
      "hidden": false
    },
    "SplashScreen": {
      "launchShowDuration": 500,
      "backgroundColor": "#0f0f14",
      "showSpinner": false
    }
  }
}